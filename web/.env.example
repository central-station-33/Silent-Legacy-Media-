# Supabase (server-only -- never prefix these with NEXT_PUBLIC_, and never
# import lib/supabase.ts from a "use client" file). This is the
# service_role key, not the anon key -- it bypasses RLS, which is exactly
# why access control lives entirely in the app (middleware.ts's password
# gate) and not in Postgres policies. Get it from the Supabase dashboard:
# Project Settings -> API -> service_role secret (labeled "secret" or
# "service_role", never the one labeled "anon" or "publishable").
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared password gating the whole app (see middleware.ts)
APP_PASSWORD=
# Random secret used to sign the session cookie
SESSION_SECRET=

# Optional: Make.com "Silent Legacy - Publish Trigger" webhook, called when an
# editorial-queue story is approved. Leave blank to skip the call.
MAKE_PUBLISH_TRIGGER_WEBHOOK_URL=

# Ghost (publishing target -- replaces WordPress). Leave both blank until
# Ghost(Pro) is set up: Approve on /drafts and the /api/publish-due cron for
# /queue both no-op on Ghost until these are set. Get these from your Ghost
# site's Settings -> Integrations -> Add custom integration.
GHOST_API_URL=
GHOST_ADMIN_API_KEY=

# Shared secret required (as `Authorization: Bearer <secret>`) to call
# /api/publish-due -- generate a random string. See web/README.md for how
# to schedule calls to this route (Supabase pg_cron, Vercel Cron, etc).
PUBLISH_CRON_SECRET=
