# Supabase (server-only -- never prefix these with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shared password gating the whole app (see middleware.ts)
APP_PASSWORD=
# Random secret used to sign the session cookie
SESSION_SECRET=

# Optional: Make.com "Silent Legacy - Publish Trigger" webhook, called when an
# editorial-queue story is approved. Leave blank to skip the call.
MAKE_PUBLISH_TRIGGER_WEBHOOK_URL=
