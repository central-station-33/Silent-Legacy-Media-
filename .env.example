# Anthropic (Scout / Verifier / Writer agents)
ANTHROPIC_API_KEY=

# Apify (ingestion actors)
APIFY_TOKEN=

# Make.com (orchestration)
MAKE_WEBHOOK_URL=

# Editorial web app (replaces Retool) -- see web/.env.example for the full set
MAKE_PUBLISH_TRIGGER_WEBHOOK_URL=

# WordPress (publishing)
WORDPRESS_URL=https://your-site.com
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
