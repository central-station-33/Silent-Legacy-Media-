# Anthropic (Scout / Verifier / Writer agents)
ANTHROPIC_API_KEY=

# Apify (ingestion actors)
APIFY_TOKEN=

# Make.com (orchestration)
MAKE_WEBHOOK_URL=

# Editorial web app (replaces Retool) -- publishes to Ghost (replaces
# WordPress -- wordpress/ is dead code now, kept for historical reference).
# See web/.env.example for the full set (GHOST_API_URL, GHOST_ADMIN_API_KEY,
# PUBLISH_CRON_SECRET, etc).
MAKE_PUBLISH_TRIGGER_WEBHOOK_URL=
